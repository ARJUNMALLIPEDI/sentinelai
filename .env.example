# Copy to .env and fill in.  `cp .env.example .env`
# .env is git-ignored. Never commit real credentials.

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
# true = one JSON object per line (for log tooling); false = human-readable
LOG_JSON=true
CORS_ORIGINS=["http://localhost:5173"]

# --- PostgreSQL (used by the postgres container and to build DATABASE_URL in compose) ---
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sentinel

# Used only when running the backend directly on your machine (outside Docker).
# Inside Compose, DATABASE_URL and REDIS_URL are set to the container hostnames.
DATABASE_URL=postgresql+asyncpg://sentinel:change-me@localhost:5432/sentinel
REDIS_URL=redis://localhost:6379/0

# --- AI agent (needed from Milestone 4; leave blank until then) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# --- Host port overrides (optional) ---
# API_PORT=8000
# FRONTEND_PORT=5173
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000
